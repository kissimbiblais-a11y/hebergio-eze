# GEMINI_API_KEY: Optionnel si des fonctions IA sont ajoutées ultérieurement.
GEMINI_API_KEY=

# APP_URL: URL publique de l'application (injectée automatiquement par AI Studio).
APP_URL=

# Paiements Mobile Money FCFA (MTN / Moov) — à configurer côté serveur uniquement
# FedaPay (https://app.fedapay.com)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox

# KKiaPay (https://app.kkiapay.me)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
